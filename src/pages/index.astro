---
import Layout from "../layouts/Layout.astro";
import "../../src/styles/global.css";
import products from "../../products.json";
import { ProductCatalog } from "../models/ProductCatalog";
import ProductCard from "../components/ProductCard.astro";

const catalog = new ProductCatalog(products);
const productList = catalog.getAllProducts();

const categories = [
  "all",
  "rings",
  "necklaces",
  "bracelets",
  "earrings",
  "watches",
];
---

<Layout title="Jewelry Shop">
  <div id="category-filter">
    <div id="category-options">
      {
        categories.map((category) => (
          <button data-category={category}>{category}</button>
        ))
      }
    </div>
		<button id="filter-toggle"> FILTER + </button>
  </div>

  <div id="product-list">
    {productList.map((product) => <ProductCard product={product} />)}
  </div>
	
</Layout>

<script>
const filterToggle = document.querySelector<HTMLButtonElement>(
  "#filter-toggle"
);

const buttons = document.querySelectorAll<HTMLButtonElement>(
  "#category-options button"
);

const categoryOptions = document.querySelector<HTMLElement>(
  "#category-options"
);

  const productCards = document.querySelectorAll<HTMLElement>(
    "#product-list article",
  );

filterToggle?.addEventListener("click", () => {
  if (categoryOptions?.style.display === "flex") {
    categoryOptions.style.display = "none";
    filterToggle.textContent = "FILTER +";
  } else {
    categoryOptions!.style.display = "flex";
    filterToggle!.textContent = "FILTER −";
  }
});
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.category;

      productCards.forEach((card) => {
        if (category === "all" || card.dataset.category === category) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
