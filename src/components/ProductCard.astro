---
import type { Product } from "../models/Product";
interface Props {
  product: Product;
}

const { product } = Astro.props;
---


<article class="product-card" data-category={product.getCategory()}>
  <a href={`/products/${product.getSlug()}`}>
    <img src={product.getImage()} alt={product.getTitle()} />
    <h2>{product.getTitle()}</h2>
    <p>{product.getFormattedPrice()}</p>
  </a>
</article>